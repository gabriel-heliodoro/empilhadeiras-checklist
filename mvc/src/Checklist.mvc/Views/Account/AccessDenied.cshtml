@{
    ViewData["Title"] = "Acesso negado";
}

<div class="cf-login-page">
    <div class="cf-login-shell cf-login-shell-panel">
        <section class="cf-login-card cf-login-card-panel">
            <div class="cf-login-panel-top">
                <img src="/assets/brand/Logo-completa.png" alt="CheckFlow" class="logo-completa cf-login-panel-brand-image" />
            </div>

            <div class="cf-auth-copy">
                <h1 class="cf-page-title">Acesso negado</h1>
                <p class="cf-page-subtitle">Seu usuario autenticou com sucesso, mas nao possui um modulo inicial disponivel para esta rota.</p>
            </div>

            <div class="cf-management-actions">
                <a class="btn btn-primary" asp-action="Login">Voltar para o login</a>
            </div>
        </section>
    </div>
</div>
