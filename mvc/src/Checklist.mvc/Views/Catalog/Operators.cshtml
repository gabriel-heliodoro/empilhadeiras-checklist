@model Checklist.Mvc.ViewModels.OperatorManagementPageViewModel
@{
    ViewData["Title"] = "Operadores";
    var isEditing = Model.Form.Id.HasValue;
}

<div class="cf-page">
    <div class="cf-page-header">
        <div>
            <h1 class="cf-page-title">Operadores</h1>
        </div>
        <div class="cf-toolbar-summary">
            <span class="cf-summary-chip">@Model.Items.Count operadores</span>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="cf-alert @(string.Equals(TempData["StatusType"] as string, "error", StringComparison.OrdinalIgnoreCase) ? "cf-alert-error" : "cf-alert-success")">@message</div>
    }

    <div class="cf-management-grid">
        <section class="cf-surface cf-surface-padded">
            <h2 class="cf-section-title">@(isEditing ? "Editar operador" : "Novo operador")</h2>
            <form asp-action="SaveOperator" method="post" class="cf-management-form">
                @Html.AntiForgeryToken()
                <input asp-for="Form.Id" type="hidden" />
                <div class="cf-filter-grid">
                    <div>
                        <label asp-for="Form.Registration" class="cf-field-label"></label>
                        <input asp-for="Form.Registration" readonly="@isEditing" />
                        <span asp-validation-for="Form.Registration" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.Name" class="cf-field-label"></label>
                        <input asp-for="Form.Name" />
                        <span asp-validation-for="Form.Name" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.LastName" class="cf-field-label"></label>
                        <input asp-for="Form.LastName" />
                        <span asp-validation-for="Form.LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="cf-filter-grid">
                    <div>
                        <label asp-for="Form.Email" class="cf-field-label"></label>
                        <input asp-for="Form.Email" />
                        <span asp-validation-for="Form.Email" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.Extension" class="cf-field-label"></label>
                        <input asp-for="Form.Extension" />
                        <span asp-validation-for="Form.Extension" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.Login" class="cf-field-label"></label>
                        <input asp-for="Form.Login" />
                        <span asp-validation-for="Form.Login" class="text-danger"></span>
                    </div>
                </div>
                <div class="cf-filter-grid">
                    <div>
                        <label asp-for="Form.Password" class="cf-field-label"></label>
                        <input asp-for="Form.Password" />
                        <span asp-validation-for="Form.Password" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.ConfirmPassword" class="cf-field-label"></label>
                        <input asp-for="Form.ConfirmPassword" />
                        <span asp-validation-for="Form.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
                <div class="cf-management-checkboxes">
                    <label class="cf-checkbox">
                        <input asp-for="Form.ForceChangePassword" type="checkbox" />
                        <span>Forcar troca de senha no proximo acesso.</span>
                    </label>
                    <label class="cf-checkbox">
                        <input asp-for="Form.IsActive" type="checkbox" />
                        <span>Operador ativo.</span>
                    </label>
                </div>
                <div class="cf-management-actions">
                    <button type="submit" class="btn btn-primary">@(isEditing ? "Salvar alteracoes" : "Criar operador")</button>
                    @if (isEditing)
                    {
                        <a asp-action="Operators" class="btn btn-outline-secondary">Limpar formulario</a>
                    }
                </div>
            </form>
        </section>

        <section class="cf-surface cf-table-section">
            <div class="cf-table-toolbar">
                <div class="cf-table-titleblock">
                    <h2 class="cf-section-title mb-0">Operadores cadastrados</h2>
                    <span class="cf-page-subtitle">Login normalizado em minusculo, com rastreio de criacao e ultimo acesso.</span>
                </div>
            </div>
            <div class="cf-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Matricula</th>
                            <th>Nome</th>
                            <th>Login</th>
                            <th>Status</th>
                            <th>Senha</th>
                            <th>Ultimo acesso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="cf-empty">Nenhum operador cadastrado para este setor.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr class="cf-data-row">
                                    <td><strong>@item.Registration</strong></td>
                                    <td>
                                        <strong>@item.FullName</strong><br />
                                        <span class="text-secondary">
                                            @(string.IsNullOrWhiteSpace(item.Email) ? "Sem email" : item.Email)
                                            @if (!string.IsNullOrWhiteSpace(item.Extension))
                                            {
                                                <text> · Ramal @item.Extension</text>
                                            }
                                            <text> · Criado em @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</text>
                                        </span>
                                    </td>
                                    <td><span class="cf-management-pill">@item.Login</span></td>
                                    <td><span class="cf-badge @(item.IsActive ? "cf-badge-success" : "cf-badge-gray")">@(item.IsActive ? "Ativo" : "Inativo")</span></td>
                                    <td><span class="cf-badge @(item.ForceChangePassword ? "cf-badge-warning" : "cf-badge-blue")">@(item.ForceChangePassword ? "Pendente" : "OK")</span></td>
                                    <td>@(item.LastLoginAt.HasValue ? item.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Nunca acessou")</td>
                                    <td class="text-end">
                                        <a asp-action="Operators" asp-route-editId="@item.Id" class="cf-link">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
