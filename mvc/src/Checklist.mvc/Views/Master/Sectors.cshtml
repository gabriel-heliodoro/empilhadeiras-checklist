@model Checklist.Mvc.ViewModels.SectorManagementPageViewModel
@{
    ViewData["Title"] = "Setores";
    var isEditing = Model.Form.Id.HasValue;
}

<div class="cf-page">
    <div class="cf-page-header">
        <div>
            <h1 class="cf-page-title">Setores</h1>
            <p class="cf-page-subtitle">Cadastro mestre com seed automatico de categorias, templates operacionais e template STP.</p>
        </div>
        <div class="cf-toolbar-summary">
            <span class="cf-summary-chip">@Model.Items.Count setores</span>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="cf-alert @(string.Equals(TempData["StatusType"] as string, "error", StringComparison.OrdinalIgnoreCase) ? "cf-alert-error" : "cf-alert-success")">@message</div>
    }

    <div class="cf-management-grid">
        <section class="cf-surface cf-surface-padded">
            <h2 class="cf-section-title">@(isEditing ? "Editar setor" : "Novo setor")</h2>
            <form asp-action="SaveSector" method="post" class="cf-management-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="cf-form-error"></div>
                <input asp-for="Form.Id" type="hidden" />
                <div>
                    <label asp-for="Form.Name" class="cf-field-label"></label>
                    <input asp-for="Form.Name" />
                    <span asp-validation-for="Form.Name" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Form.Description" class="cf-field-label"></label>
                    <textarea asp-for="Form.Description" rows="4"></textarea>
                    <span asp-validation-for="Form.Description" class="text-danger"></span>
                </div>
                <label class="cf-checkbox">
                    <input asp-for="Form.IsActive" type="checkbox" />
                    <span>Setor ativo para novos cadastros e operacao.</span>
                </label>
                <div class="cf-management-actions">
                    <button type="submit" class="btn btn-primary">@(isEditing ? "Salvar alteracoes" : "Criar setor")</button>
                    @if (isEditing)
                    {
                        <a asp-action="Sectors" class="btn btn-outline-secondary">Limpar formulario</a>
                    }
                </div>
            </form>
        </section>

        <section class="cf-surface cf-table-section">
            <div class="cf-table-toolbar">
                <div class="cf-table-titleblock">
                    <h2 class="cf-section-title mb-0">Setores cadastrados</h2>
                    <span class="cf-page-subtitle">Contagem operacional por setor.</span>
                </div>
            </div>
            <div class="cf-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Setor</th>
                            <th>Status</th>
                            <th>Supervisores</th>
                            <th>Equipamentos</th>
                            <th>Operadores</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="cf-data-row">
                                <td>
                                    <strong>@item.Name</strong><br />
                                    <span class="text-secondary">@item.Description</span>
                                </td>
                                <td><span class="cf-badge @(item.IsActive ? "cf-badge-success" : "cf-badge-gray")">@(item.IsActive ? "Ativo" : "Inativo")</span></td>
                                <td>@item.SupervisorCount</td>
                                <td>@item.EquipmentCount</td>
                                <td>@item.OperatorCount</td>
                                <td class="text-end">
                                    <a asp-action="Sectors" asp-route-editId="@item.Id" class="cf-link">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
